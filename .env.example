# DocuMan — copy to .env and fill in. Never commit the filled-in .env.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/documan?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: pnpm exec auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (Google Cloud console > APIs & Services > Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth.js refuses to infer the origin from an untrusted Host header. Set this
# when the app is self-hosted or sits behind a reverse proxy, which is any
# deployment other than Vercel — without it every request fails with
# "UntrustedHost". Required for local development too.
AUTH_TRUST_HOST="true"

# Only needed when the origin still cannot be inferred (e.g. a proxy that
# rewrites the host).
# AUTH_URL="https://documan.example.com"

# Comma-separated list of e-mail domains allowed to sign in.
# Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAINS="assetfive.co.th"

# --- Google AI Studio (OCR) ----------------------------------------------
# API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=""
# "gemini-2.5-flash" is listed by the API but rejects requests from keys
# created after Google's cutoff for that model ("no longer available to new
# users"). The "-latest" alias avoids pinning to a version that can be
# sunset later; see src/lib/env.ts for the same default.
GEMINI_MODEL="gemini-flash-latest"

# --- Google Drive (document storage) -------------------------------------
# Name of the Drive folder DocuMan creates to hold uploads.
GOOGLE_DRIVE_ROOT_FOLDER_NAME="DocuMan"
