# DocuMan — copy to .env and fill in. Never commit the filled-in .env.

# --- Database -------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/documan?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: pnpm exec auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth client (Google Cloud console > APIs & Services > Credentials).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Auth.js refuses to infer the origin from an untrusted Host header. Set this
# when the app is self-hosted or sits behind a reverse proxy, which is any
# deployment other than Vercel — without it every request fails with
# "UntrustedHost". Required for local development too.
AUTH_TRUST_HOST="true"

# Only needed when the origin still cannot be inferred (e.g. a proxy that
# rewrites the host).
# AUTH_URL="https://documan.example.com"

# Comma-separated list of e-mail domains allowed to sign in.
# Leave empty to allow any Google account.
ALLOWED_EMAIL_DOMAINS="assetfive.co.th"

# --- Google AI Studio (OCR) ----------------------------------------------
# API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=""
# "gemini-2.5-flash" is listed by the API but rejects requests from keys
# created after Google's cutoff for that model ("no longer available to new
# users"). The "-latest" alias avoids pinning to a version that can be
# sunset later; see src/lib/env.ts for the same default.
GEMINI_MODEL="gemini-flash-latest"

# --- Google Drive (document storage) -------------------------------------
# Name of the Drive folder DocuMan creates to hold uploads.
GOOGLE_DRIVE_ROOT_FOLDER_NAME="DocuMan"

# --- LINE Messaging API ---------------------------------------------------
# From https://developers.line.biz/console/ for the Messaging API channel.
# The secret signs every webhook delivery; the token authorises replies and
# pushes. Both are needed before the OA can do anything.
LINE_CHANNEL_SECRET=""
LINE_CHANNEL_ACCESS_TOKEN=""

# The LIFF app, created on the Messaging API channel's own LIFF tab — no
# separate LINE Login channel is needed. LINE_LIFF_CHANNEL_ID is then that same
# channel's Channel ID, from Basic settings.
#
# The pages the bot links to — drawing a signature, correcting what OCR read,
# reading a claim — identify their visitor by an ID token LINE issues to the
# page, and LINE_LIFF_CHANNEL_ID is the audience LINE checks it against. Keeping
# both on one channel is what makes the id in that token the same id the webhook
# receives; split across providers, one person arrives as two unrelated ids.
#
# Two console settings no code can enforce:
#   Endpoint URL must be https://<app>/liff — NOT the site root. A LIFF app has
#     one Endpoint URL, and a liff.line.me link opens it unchanged, with
#     whatever follows the LIFF id packed into a liff.state query param; LIFF
#     then completes a second real navigation whose target is the Endpoint's
#     own path with that remainder APPENDED — liffUrl() strips the /liff the
#     Endpoint already supplies before building the link, or that second hop
#     lands on /liff/liff/signature instead of /liff/signature.
#     /liff (src/app/liff/page.tsx) is that landing spot. The site root cannot
#     serve this — it is the signed-in dashboard, which redirects anyone with
#     no session to /login before the LIFF SDK gets to run at all.
#   Scopes must include openid, or getIDToken() returns null and the pages have
#     no way to say who is looking.
LINE_LIFF_ID=""
LINE_LIFF_CHANNEL_ID=""

# Absolute origin for links sent into LINE (LIFF pages, document links). Vercel
# sets VERCEL_URL per deployment, which changes on every push and would leave
# already-sent messages pointing at a stale one — so set this to the stable
# production URL there.
APP_URL="http://localhost:3000"

# --- PDF rendering ------------------------------------------------------
# Path to a Chromium binary, for development and CI. Unset in production,
# where @sparticuz/chromium unpacks one built for the serverless runtime.
# Playwright's copy is a good local choice, e.g.
#   CHROMIUM_EXECUTABLE_PATH="/opt/pw-browsers/chromium"
CHROMIUM_EXECUTABLE_PATH=""
